      "link": null,
      "locked": false,
      "text": "item_db = [{\"id\":1, \"name\":\"mahima\"},{\"id\":2, \"name\":\"chatterjee\"}]\nfor item in item_db:\n\n1st iteration: item = {\"id\":1, \"name\":\"mahima\"}\n if item['id'] == item_id:\nif 1 == 2 -->false\n\n2nd iteration : item={\"id\":2, \"name\":\"chatterjee\"}\nif item['id']==item_id:\nif 2==2---->true\n\nreturn jsonify(item)\n\n",
      "fontSize": 18.933333333333316,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "item_db = [{\"id\":1, \"name\":\"mahima\"},{\"id\":2, \"name\":\"chatterjee\"}]\nfor item in item_db:\n\n1st iteration: item = {\"id\":1, \"name\":\"mahima\"}\n if item['id'] == item_id:\nif 1 == 2 -->false\n\n2nd iteration : item={\"id\":2, \"name\":\"chatterjee\"}\nif item['id']==item_id:\nif 2==2---->true\n\nreturn jsonify(item)\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
